# The source distribution: what pip needs to build the extension, and nothing
# else. The prebuilt binaries in the repository are left out; pip builds its own.
include PsychMetalDisplayLink.h PsychMetalCustomShader.h PsychMetalLiveTimeline.h PsychMetalKeyframes.h PsychMetalTimeline.h PsychMetalReadback.h PsychMetalEngine.h PsychMetalInternal.h PsychMetalKeyboardQueue.h PsychMetalShaders.h PsychMetalIOS.h PsychMetalAudio.h PsychMetalAudioHost.h PsychMetalAudioEngine.h PsychMetalMovie.h PsychMetalRecord.h PsychMetalRecordingClock.h PsychMetalOfflineAudio.h PsychMetalImaging.h
include python/README.md
global-exclude *.so *.mex *.mexmaca64 *.o
prune tests
# Built into the engine at build time.
include PsychMetalShaders.metal tests/build_metallib.py
prune phone

include TIMELINE.md
include GPU-MASKS.md

include MASKED-IMAGES.md

include CUSTOM-SHADERS.md

include python/custom-shader-demo.metal

include AUDIO.md

include MOVIES.md

include OFFSCREEN-EXPORT.md

include WISHLIST-0.10.0.md

include HDR.md IMAGING.md
